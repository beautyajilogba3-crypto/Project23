  m_OnCullStateChanged:
    m_PersistentCalls:
      m_Calls: []
  m_text: "\r\n\r\nAn artefact worth $3 billion has been placed inside the Grand
    Museum \u2014 but it has been split into three fragments and hidden in three
    different rooms.\r\n\r\nYour job is to retrieve all three artefact fragments
    before time runs out.\r\n\r\nEach room has its own timer and a task that must
    be completed before you can leave.\r\n\r\nBut there's one more problem...\r\n\r\nA
    security guard is patrolling the museum. Stay alert and avoid getting caught.\r\n\r\nEnter
    the room. Complete the task. Get the artefact. Escape before the timer reaches
    zero.\r\n\r\nCollect all three fragments and combine them to obtain the artefact.\n\r\nARE
    YOU READY?\r\n\r\nPress           to begin the heist.\r\n"
  m_isRightToLeft: 0
